{
  "name": "react-shapefile-arcgis",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@adobe/css-tools": "^4.4.3",
    "@arcgis/core": "^4.32.10",
    "@capacitor-community/sqlite": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.1",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.0",
    "@esri/arcgis-to-geojson-utils": "^1.3.0",
    "@ionic-native/file": "^5.36.0",
    "@mapbox/shp-write": "^0.4.3",
    "@nickrsan/shp-write": "^0.3.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "arcgis-to-geojson-utils": "^1.0.3",
    "archiver": "^7.0.1",
    "assert": "^2.1.0",
    "capacitor-file-picker": "^1.0.10",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-saf-mediastore": "^1.0.10",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "geojson2shp": "^0.5.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-native": "^0.80.1",
    "react-scripts": "^5.0.1",
    "shp-write": "^0.3.2",
    "shpjs": "^6.1.0",
    "uuid": "^11.1.0",
    "web-vitals": "^2.1.4",
    "worker-plugin": "^5.0.0"
  },
  "scripts": {
    "start": "concurrently --names \"LOGGER,CLIENT\" -c \"cyan,green\" \"npm run server\" \"npm run client\" \"npm run export\"",
    "client": "craco start",
    "server": "node server/logger.js",
    "export": "node server/ogr2ogrExportService.js",
    "build": "npm run copy:core && craco build",
    "test": "craco test",
    "eject": "craco eject",
    "copy:core": "cpx \"node_modules/@arcgis/core/assets/**/*.*\" public/assets",
    "dev": "npm run copy:core && react-scripts start",
    "electron": "electron .",
    "electron-build": "npm run build && electron .",
    "dist": "electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.1",
    "@capacitor/cli": "^7.4.1",
    "@capacitor/core": "^7.4.1",
    "@craco/craco": "^7.1.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.0",
    "cpx": "^1.5.0",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "worker-loader": "^3.0.8"
  },
  "build": {
    "appId": "com.reactshapefilearcgis.app",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "asarUnpack": [
      "electron/**/*"
    ]
  }
}
